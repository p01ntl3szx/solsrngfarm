local pathFolder = Instance.new("Folder", workspace)

local currentPathParts = {}

local function drawPath(points)
	-- clear old
	for _, p in pairs(currentPathParts or {}) do
		if p then p:Destroy() end
	end
	currentPathParts = {}

	for i, wp in ipairs(points) do
		local p = Instance.new("Part")
		p.Size = Vector3.new(0.6,0.6,0.6)
		p.Position = wp.Position + Vector3.new(0,0.2,0)
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(170,0,255)
		p.Parent = pathFolder

		currentPathParts[i] = p
	end

	return currentPathParts
end

local lastPathTime = 0

local function findJumpPoint(root, targetPos)
	local best = nil
	local bestScore = math.huge

	for i = 1, 25 do
		local offset = Vector3.new(
			math.random(-40,40),
			math.random(5,25), -- prefer higher spots
			math.random(-40,40)
		)

		local pos = root.Position + offset

		local ray = Ray.new(pos, Vector3.new(0,-50,0))
		local hit = workspace:FindPartOnRay(ray)

		if hit then
			local groundPos = hit.Position

			local distToTarget = (groundPos - targetPos).Magnitude

			-- prefer positions closer to target AND higher
			local score = distToTarget - (groundPos.Y * 0.5)

			if score < bestScore then
				bestScore = score
				best = groundPos
			end
		end
	end

	return best
end

local function walkTo(root, humanoid, dest)
	local character = player.Character
	local lastPos = root.Position
	local stuckTime = 0

	while RUNNING do
		-- avoid known bad spots
		if isBadPosition(dest) then
			LogOnce("badpos_"..tostring(dest), "Skipping bad location", 3)
			return false
		end

		local path = PathfindingService:CreatePath({
			AgentCanJump = true,
			AgentJumpHeight = 8,
			AgentRadius = 2,
			AgentMaxSlope = 45
		})

		path:ComputeAsync(root.Position, dest)

		if path.Status ~= Enum.PathStatus.Success then
			Log("Path failed → trying strategies","warn")

			local attempts = (lastTargetEgg and strategyMemory[lastTargetEgg.part]) or 1

			if attempts >= 3 then
				local jumpPoint = findJumpPoint(root, dest)

				if jumpPoint then
					Log("Jump point found → repositioning","info")

					humanoid:MoveTo(jumpPoint)
					task.wait(1.5)

					humanoid:MoveTo(dest)
					humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

					task.wait(0.8)
					return false
				end
			end

			-- fallback
			LogOnce("pathfail_mark", "Path failed → marking bad", 2)
			table.insert(badPositions, dest)

			if #badPositions > 20 then
				table.remove(badPositions, 1)
			end

			return false
		end

		local waypoints = path:GetWaypoints()
		local visuals = drawPath(waypoints)

		for i, wp in ipairs(waypoints) do

			if isPlayerOverriding() then
				Log("Player override → pausing path","warn")

				-- STOP movement immediately
				humanoid:MoveTo(root.Position)

				-- wait until player stops moving
				repeat task.wait(0.2) until not isPlayerOverriding()

				Log("Resuming path...","info")
				return false -- force path recalculation
			end

			-- climb detection
			local ray = Ray.new(root.Position, (wp.Position - root.Position).Unit * 4)
			local hit = workspace:FindPartOnRay(ray, root.Parent)

			if hit and hit:IsA("TrussPart") then
				humanoid:ChangeState(Enum.HumanoidStateType.Climbing)
			end

			-- jump handling
			if wp.Action == Enum.PathWaypointAction.Jump then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end

			humanoid:MoveTo(wp.Position)

			local reached = false

			local conn
			conn = humanoid.MoveToFinished:Connect(function(r)
				reached = r
			end)

			local timeout = 0

			while not reached and timeout < 50 do
				if isPlayerOverriding() then
					Log("Player override → stopping instantly","warn")

					humanoid:MoveTo(root.Position)
					conn:Disconnect()

					repeat task.wait(0.2) until not isPlayerOverriding()

					Log("Resuming path...","info")
					return false
				end

				timeout = timeout + 1
				task.wait(0.1)
			end

			if timeout >= 50 then
				LogOnce("movetimeout", "Move timeout → recalculating", 2)
				conn:Disconnect()
				return false
			end

			conn:Disconnect()

			-- remove path dot
			if visuals and visuals[i] then
				visuals[i]:Destroy()
			end

			-- stuck detection
			if (root.Position - lastPos).Magnitude < 1 then
				stuckTime = stuckTime + 1
			else
				stuckTime = 0
			end

			lastPos = root.Position

			if stuckTime >= 3 then
				Log("Stuck → strafing + marking bad","warn")

				table.insert(badPositions, root.Position)

				pathFailures[lastTargetEgg] = (pathFailures[lastTargetEgg] or 0) + 1

				local attempts = pathFailures[lastTargetEgg] or 1
				local strafePoints = getStrafePositions(root.Position, dest, attempts)

				for _, pos in ipairs(strafePoints) do
					humanoid:MoveTo(pos)
					task.wait(0.35)

					-- break early if unstuck
					if (root.Position - lastPos).Magnitude > 2 then
						break
					end
				end

				return false
			end

			if not reached then
				break
			end
		end

		local dist = (root.Position - dest).Magnitude

		if dist < 35 and dist > 8 then
			local ray = Ray.new(root.Position, (dest - root.Position))
			local hit = workspace:FindPartOnRay(ray, character)

			if not hit then
				Log("Gap detected → attempting jump","warn")

				humanoid:MoveTo(dest)
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)

				task.wait(0.5)
			end
		end

		if (root.Position - dest).Magnitude < 6 then
			return true
		end

		task.wait(0.2)
	end

	return false
end

