local function closestEgg(root)
	local best, dist = nil, math.huge
	local eggs = getEggs() or {}
	for _, egg in pairs(eggs) do
		if egg and egg.part and failedEggs[egg.part] ~= math.huge then
			
			local heightDiff = math.abs(root.Position.Y - egg.part.Position.Y)
			local d = (root.Position - egg.part.Position).Magnitude

			if successMemory[egg.part] then
				d = d - 50 -- prioritize known good routes
			end

			-- penalize unreachable heights
			if heightDiff > 25 then
				d = d + 300
			elseif heightDiff > 12 then
				d = d + 120
			end

			if not isActuallyReachable(root.Position, egg.part.Position) then
				d = d + 400
			end

			-- avoid bad areas
			if isBadPosition(egg.part.Position) then
				d = d + 200
			end

			if failedEggs[egg.part] then
				local t = tick() - failedEggs[egg.part]

				if t < 5 then
					d = d + 100
				else
					failedEggs[egg.part] = nil
				end
			end

			if d < dist then
				dist = d
				best = egg
			end

		end
	end
	return best
end

