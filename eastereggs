-- ✅ LADDER DETECTION
local function findNearbyLadder(rootPos, targetPos)
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.find(string.lower(v.Name), "ladder") then
            local distToPlayer = (v.Position - rootPos).Magnitude
            local distToTarget = (v.Position - targetPos).Magnitude
            -- Ladder must be reasonably close to both player and egg
            if distToPlayer < 30 and distToTarget < 30 then
                return v
            end
        end
    end
    return nil
end

local function tryClimbLadder(root, humanoid, targetPos)
    local ladder = nil
    for _, v in pairs(workspace:GetDescendants()) do
        if v:IsA("BasePart") and string.find(string.lower(v.Name), "ladder") then
            local distToPlayer = (v.Position - root.Position).Magnitude
            -- If a ladder is within 25 studs, we can try to grab it
            if distToPlayer < 25 then
                ladder = v
                break
            end
        end
    end
    
    if not ladder then return false end
    
    -- Calculate ladder top and bottom
    local ladderTop = ladder.CFrame * CFrame.new(0, ladder.Size.Y/2, 0)
    local ladderBottom = ladder.CFrame * CFrame.new(0, -ladder.Size.Y/2, 0)
    
    -- If we are already higher than the ladder, we don't need it
    if ladderTop.Position.Y < root.Position.Y + 2 then return false end

    Log("Found ladder: " .. ladder.Name .. " -> Jumping to clutch!", "info")

    -- Walk to the base of the ladder
    humanoid:MoveTo(ladderBottom.Position + Vector3.new(0, 1, 0))
    task.wait(1.2)

    -- Force jump to grab the ladder 5 studs up
    local climbDir = (ladder.Position - root.Position).Unit
    humanoid:MoveTo(ladderBottom.Position + Vector3.new(0, 5, 0))
    humanoid.Jump = true
    task.wait(0.15)
    humanoid.Jump = true -- Double tap to ensure clutch
    
    -- Wait until the player's Y height reaches the top of the ladder
    local climbTimeout = tick() + 8 -- Max 8 seconds to climb

    while tick() < climbTimeout do
        -- If we reached the top of the ladder
        if root.Position.Y >= ladderTop.Position.Y - 2 then
            Log("Reached top of ladder!", "success")
            
            -- Walk forward off the top of the ladder to cross the gap
            humanoid:ChangeState(Enum.HumanoidStateType.Running)
            humanoid:MoveTo(ladderTop.Position + climbDir * 8)
            task.wait(1.5)
            
            return true -- Success!
        end
        
        -- If we fell back down, try jumping again
        if math.abs(root.Position.Y - ladderBottom.Position.Y) < 2 then
            humanoid:MoveTo(ladderBottom.Position + Vector3.new(0, 5, 0))
            humanoid.Jump = true
            task.wait(0.5)
        end
        
        task.wait(0.1)
    end

    Log("Failed to climb ladder", "error")
    return false
end

-- ✅ BULLETPROOF MOVEMENT SYSTEM
-- This forces the character to move every single frame, ignoring whatever 
-- game script or executor bug was stopping 'MoveTo' from working.
