local function getEggs()
	return cachedEggs or {}
end

local function getValidEggCount()
	local count = 0
	for _, egg in pairs(cachedEggs or {}) do
		if egg and egg.part and egg.part.Parent then
			count = count + 1
		end
	end
	return count
end

local function isBadPosition(pos)
	for _, p in pairs(badPositions) do
		if (p - pos).Magnitude < 8 then
			return true
		end
	end
	return false
end

local function closestEgg(root)
	local best, dist = nil, math.huge
	local eggs = getEggs() or {}
	for _, egg in pairs(eggs) do
		if failedEggs[egg.part] ~= math.huge then
			
			local d = (root.Position - egg.part.Position).Magnitude

			-- avoid bad areas
			if isBadPosition(egg.part.Position) then
				d = d + 200
			end

			if failedEggs[egg.part] then
				local t = tick() - failedEggs[egg.part]

				if t < 5 then
					d = d + 100
				else
					failedEggs[egg.part] = nil
				end
			end

			if d < dist then
				dist = d
				best = egg
			end

		end
	end
	return best
end

local function getStrafePositions(rootPos, targetPos, attempt)
	local positions = {}

	local dir = (targetPos - rootPos).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X) -- perpendicular
	local back = -dir

	-- pattern scaling
	local scale = 4 + (attempt * 2)

	if attempt == 1 then
		-- simple left/right
		table.insert(positions, rootPos + right * scale)
		table.insert(positions, rootPos - right * scale)

	elseif attempt == 2 then
		-- triangle movement
		table.insert(positions, rootPos + right * scale)
		table.insert(positions, rootPos + back * scale)
		table.insert(positions, rootPos - right * scale)

	elseif attempt == 3 then
		-- circle around target
		for i = 1, 6 do
			local angle = math.rad(i * 60)
			local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * scale
			table.insert(positions, targetPos + offset)
		end

	else
		-- chaos mode (last resort)
		for i = 1, 5 do
			table.insert(positions, rootPos + Vector3.new(
				math.random(-10,10),
				0,
				math.random(-10,10)
			))
		end
	end

	return positions
end

