local function isValidEgg(v)
	if not v:IsA("BasePart") then return false end
	if BLACKLIST[v.Name] then return false end

	local name = string.lower(v.Name)

	-- allow ALL eggs
	if name == "egg" then return true end
	if name:find("egg") then return true end

	return false
end

local cachedEggs = {}

local function refreshEggs()
	cachedEggs = {}

	for _, v in pairs(workspace:GetDescendants()) do
		if isValidEgg(v) then
			local prompt = v:FindFirstChildWhichIsA("ProximityPrompt", true)

			table.insert(cachedEggs, {
				part = v,
				prompt = prompt
			})
		end
	end
end

