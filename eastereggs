-- ✅ SMART ISLAND HOPPER (Chain-jumps across mini islands)
local function smartIslandHop(root, humanoid, dest)
    local startPos = root.Position
    local targetXZ = Vector3.new(dest.X, 0, dest.Z)
    local startXZ = Vector3.new(startPos.X, 0, startPos.Z)
    
    local totalDistXZ = (targetXZ - startXZ).Magnitude
    if totalDistXZ < 4 then return false end
    
    local dirUnit = (targetXZ - startXZ).Unit
    
    -- Tell raycasts to completely ignore water blocks so we only see actual islands
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = waterBlocks

    -- Make sure there isn't a giant wall in the way
    local wallRay = workspace:Raycast(startPos + Vector3.new(0, 3, 0), dirUnit * totalDistXZ, rayParams)
    if wallRay then
        return false -- A solid wall is blocking us, can't jump over it
    end
    
    local jumpPoints = {}
    local currentXZ = startXZ
    local maxJump = 13 -- 13 studs is your max jump distance with 18 walkspeed

    -- Build a chain of islands to jump to
    while (currentXZ - targetXZ).Magnitude > maxJump do
        local found = false
        
        -- Look for the farthest possible island within jump range (13 down to 5 studs)
        for step = maxJump, 5, -1 do
            local checkXZ = currentXZ + (dirUnit * step)
            local checkPos3D = Vector3.new(checkXZ.X, startPos.Y, checkXZ.Z)
            
            -- Shoot a ray straight down to find an island
            local downRay = workspace:Raycast(checkPos3D + Vector3.new(0, 30, 0), Vector3.new(0, -60, 0), rayParams)
            
            if downRay then
                -- Found an island! Add it to our path
                table.insert(jumpPoints, downRay.Position + Vector3.new(0, 0.5, 0))
                currentXZ = checkXZ
                found = true
                break
            end
        end
        
        if not found then
            Log("Island gap too wide to jump!", "error")
            return false -- Gap is > 13 studs, impossible to cross
        end
    end
    
    -- Add the final egg destination
    table.insert(jumpPoints, dest + Vector3.new(0, 0.5, 0))
    
    Log("Found island hop path! ("..#jumpPoints.." jumps)", "success")
    
    -- Execute the jumps!
    for _, point in ipairs(jumpPoints) do
        local distToPoint = (root.Position - point).Magnitude
        
        -- Safety check
        if distToPoint > 15 then
            Log("Skipping impossible jump ("..math.floor(distToPoint).." studs)", "warn")
            return false
        end
        
        humanoid:MoveTo(point)
        humanoid.Jump = true
        
        -- Wait to land on the island
        local waitTime = 0
        while (root.Position - point).Magnitude > 4 and waitTime < 2 do
            task.wait(0.1)
            waitTime = waitTime + 0.1
        end
        task.wait(0.2) -- Tiny pause to regain balance before next jump
    end
    
    -- Check if we made it
    return (root.Position - dest).Magnitude < 10
end

local function tryCliffDrop(root, humanoid, dest)
    local heightDrop = root.Position.Y - dest.Y
    
    -- If the egg is more than 12 studs below us
    if heightDrop > 12 then
        Log("Egg is far below ("..math.floor(heightDrop).." studs) -> Dropping off cliff!", "info")
        
        -- Walk to the X/Z coordinates of the egg (this moves us to the edge)
        local edgeTarget = Vector3.new(dest.X, root.Position.Y, dest.Z)
        humanoid:MoveTo(edgeTarget)
        
        -- Wait until we are right above the egg or we walk off
        local dropWait = 0
        while (root.Position - edgeTarget).Magnitude > 4 and dropWait < 4 do
            task.wait(0.1)
            dropWait = dropWait + 0.1
        end
        
        -- Walk straight down to the egg
        humanoid:MoveTo(dest)
        task.wait(1.5)
        
        -- Check if we landed near it
        return (root.Position - dest).Magnitude < 15
    end
    
    return false
end

local function walkTo(root, humanoid, dest)
    -- ✅ CRITICAL FIX: Force the character to be able to walk
    -- If the game secretly set your speed to 0, this fixes it
    if humanoid.PlatformStand then humanoid.PlatformStand = false end
    if humanoid.WalkSpeed <= 0 then humanoid.WalkSpeed = 16 end

    local lastPos = root.Position
    local stuckTime = 0

    local heightDiff = dest.Y - root.Position.Y
    
    -- If egg is high up, try ladder first
    if heightDiff > 6 then
        if tryClimbLadder(root, humanoid, dest) then
            return false -- Recalculate path from top of ladder
        end
    end

    local path = PathfindingService:CreatePath({
        AgentCanJump = true,
        AgentJumpHeight = 12,
        AgentRadius = 2,
        AgentMaxSlope = 50,
        Costs = { Blocked = math.huge }
    })

    path:ComputeAsync(root.Position, dest)
    
    if path.Status ~= Enum.PathStatus.Success then
		Log("Normal path blocked -> checking smart fallbacks", "warn")
		-- 1. Can we just drop down the cliff? (No fall damage!)
		if tryCliffDrop(root, humanoid, dest) then
			return true
		end

		-- 2. Can we island hop across the water?
		if smartIslandHop(root, humanoid, dest) then
			return true
		end

		-- 3. Can we find a ladder to jump up and cross the gap? 
		-- (We run this even if the egg isn't high up, because the ladder might CROSS a gap)
		if tryClimbLadder(root, humanoid, dest) then
			return false -- Recalculate path from the new side
		end
				
		-- 4. Absolute last resort: mark as bad and skip
		table.insert(badPositions, dest)
		if #badPositions > 20 then table.remove(badPositions, 1) end
		return false
	end

    local waypoints = path:GetWaypoints()
    local visuals = drawPath(waypoints)

    -- ✅ USING YOUR SECOND SCRIPT'S EXACT WALKING LOGIC
    for i, wp in ipairs(waypoints) do
        if not RUNNING then 
            return false 
        end

        -- Force jump state (Roblox standard for pathfinding jumps)
        if wp.Action == Enum.PathWaypointAction.Jump then
            humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
        end

        -- Force walkable state before EVERY single step
        if humanoid.PlatformStand then humanoid.PlatformStand = false end
        if humanoid.WalkSpeed <= 0 then humanoid.WalkSpeed = 16 end

        -- ✅ THE HOLY GRAIL: MoveTo + Wait
        -- This tells Roblox's core engine to walk. No loops, no overriding.
        humanoid:MoveTo(wp.Position)
        local reached = humanoid.MoveToFinished:Wait()

        -- Remove path dot
        if visuals and visuals[i] then
            visuals[i]:Destroy()
        end

        -- STUCK DETECTION
        if (root.Position - lastPos).Magnitude < 1 then
            stuckTime = stuckTime + 1
        else
            stuckTime = 0
        end
        lastPos = root.Position

        if stuckTime >= 3 then
            Log("Stuck → strafing", "warn")
            table.insert(badPositions, root.Position)
            
            -- Unstick
            for j = 1, 3 do
                local offset = Vector3.new(math.random(-6,6), 0, math.random(-6,6))
                humanoid:MoveTo(root.Position + offset)
                task.wait(0.4)
            end
            return false
        end

        -- ✅ If the player presses WASD, MoveToFinished AUTOMATICALLY returns false!
        if not reached then
            return false 
        end
    end

    if (root.Position - dest).Magnitude < 6 then
        return true
    end

    return false
end

local VirtualInputManager = game:GetService("VirtualInputManager")

local function pressE()
	VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
	task.wait(0.1)
	VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
end

local EGG_REWARDS = {
	["point_egg_1"] = 50,
	["point_egg_2"] = 100,
	["point_egg_3"] = 150,
	["point_egg_4"] = 200,
	["point_egg_5"] = 300,
	["point_egg_6"] = 500
}

local function collectEgg(egg, root, humanoid)
	if not egg or not egg.part then return false end

	local attempts = 0

	while attempts < 8 do
		attempts = attempts + 1

		if not egg.part or not egg.part.Parent then
			return true
		end

		local prompt = egg.part:FindFirstChildWhichIsA("ProximityPrompt", true)

		local targetPos = egg.part.Position

		if prompt then
			if prompt.Parent:IsA("BasePart") then
				targetPos = prompt.Parent.Position
			elseif prompt.Parent:IsA("Attachment") then
				targetPos = prompt.Parent.WorldPosition
			end
		end

		local dist = (root.Position - targetPos).Magnitude

		-- move closer aggressively
		if dist > 8 then
			humanoid:MoveTo(targetPos)
			task.wait(0.3)
		else
			-- micro adjust (VERY IMPORTANT)
			humanoid:MoveTo(targetPos + Vector3.new(math.random(-2,2),0,math.random(-2,2)))
			task.wait(0.2)

			pressE()

			local success = false
			local startTime = tick()
			local initialPos = targetPos

			while tick() - startTime < 2 do
				-- egg removed
				if not egg.part or not egg.part.Parent then
					success = true
					break
				end

				-- egg moved (some games do this)
				if (egg.part.Position - initialPos).Magnitude > 3 then
					success = true
					break
				end

				-- player moved away = likely collected
				if (root.Position - targetPos).Magnitude > 10 then
					success = true
					break
				end

				task.wait(0.05)
			end

			if success then
				local rawName = string.lower(egg.part.Name)

				local rewardValue = 0
				for k, v in pairs(EGG_REWARDS) do
					if rawName:find(k) then
						rewardValue = v
						break
					end
				end

				local rewardText = rewardValue > 0 and ("+"..rewardValue.." Easter Coins") or "+ Egg"

				totalEggs = totalEggs + 1
				totalCoins = totalCoins + rewardValue
				updateStats()
				successMemory[egg.part] = true

				Log("Collected "..egg.part.Name.." - "..rewardText, "success")
				return true
			end
		end

		task.wait(0.25)
	end

	failedEggs[egg.part] = tick()
	Log("Failed "..egg.part.Name.." after retries","error")

	return false
end

