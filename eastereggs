local function isValidEgg(v)
	if not v:IsA("BasePart") then return false end
	if BLACKLIST[v.Name] then return false end

	local name = string.lower(v.Name)

	-- allow ALL eggs
	if name == "egg" then return true end
	if name:find("egg") then return true end

	return false
end

local cachedEggs = {}

local function refreshEggs()
	cachedEggs = {}

	for _, v in pairs(workspace:GetDescendants()) do
		if isValidEgg(v) then
			local prompt = v:FindFirstChildWhichIsA("ProximityPrompt", true)

			table.insert(cachedEggs, {
				part = v,
				prompt = prompt
			})
		end
	end
end

task.spawn(function()
	while true do
		refreshEggs()
		task.wait(3)
	end
end)

local function getEggs()
	if ESP_ENABLED then
		clearESP()
		for _, v in pairs(cachedEggs) do
			createESP(v)
		end
	end
	return cachedEggs
end

local function isBadPosition(pos)
	for _, p in pairs(badPositions) do
		if (p - pos).Magnitude < 8 then
			return true
		end
	end
	return false
end

local function closestEgg(root)
	local best, dist = nil, math.huge
	for _, egg in pairs(getEggs()) do
		local d = (root.Position - egg.part.Position).Magnitude
		-- avoid bad areas
		if isBadPosition(egg.part.Position) then
			d = d + 200
		end

		if failedEggs[egg] then
			local t = tick() - failedEggs[egg]

			if t < 5 then
				d = d + 100 -- avoid briefly
			else
				failedEggs[egg] = nil -- retry later
			end
		end

		if d < dist then
			dist = d
			best = egg
		end
	end
	return best
end

