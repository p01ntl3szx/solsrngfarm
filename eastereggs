local function collectEgg(egg, root, humanoid)
	if not egg or not egg.part then return false end

	local attempts = 0

	while attempts < 8 do
		attempts = attempts + 1

		if not egg.part or not egg.part.Parent then
			return true
		end

		local prompt = egg.part:FindFirstChildWhichIsA("ProximityPrompt", true)

		local targetPos = egg.part.Position

		if prompt then
			if prompt.Parent:IsA("BasePart") then
				targetPos = prompt.Parent.Position
			elseif prompt.Parent:IsA("Attachment") then
				targetPos = prompt.Parent.WorldPosition
			end
		end

		local dist = (root.Position - targetPos).Magnitude

		-- move closer aggressively
		if dist > 8 then
			humanoid:MoveTo(targetPos)
			task.wait(0.3)
		else
			-- micro adjust (VERY IMPORTANT)
			humanoid:MoveTo(targetPos + Vector3.new(math.random(-2,2),0,math.random(-2,2)))
			task.wait(0.2)

			pressE()

			local success = false
			local startTime = tick()
			local initialPos = targetPos

			while tick() - startTime < 2 do
				-- egg removed
				if not egg.part or not egg.part.Parent then
					success = true
					break
				end

				-- egg moved (some games do this)
				if (egg.part.Position - initialPos).Magnitude > 3 then
					success = true
					break
				end

				-- player moved away = likely collected
				if (root.Position - targetPos).Magnitude > 10 then
					success = true
					break
				end

				task.wait(0.05)
			end

			if success then
				local rawName = string.lower(egg.part.Name)

				local rewardValue = 0
				for k, v in pairs(EGG_REWARDS) do
					if rawName:find(k) then
						rewardValue = v
						break
					end
				end

				local rewardText = rewardValue > 0 and ("+"..rewardValue.." Easter Coins") or "+ Egg"

				totalEggs = totalEggs + 1
				totalCoins = totalCoins + rewardValue
				updateStats()

				Log("Collected "..egg.part.Name.." - "..rewardText, "success")
				return true
			end
		end

		task.wait(0.25)
	end

	failedEggs[egg.part] = tick()
	Log("Failed "..egg.part.Name.." after retries","error")

	return false
end

--// =========================
--// MAIN LOOP
--// =========================

local lastTargetEgg = nil

task.spawn(function()
	while true do
		if RUNNING then
			local char = player.Character or player.CharacterAdded:Wait()
			local root = char:WaitForChild("HumanoidRootPart")
			local humanoid = char:WaitForChild("Humanoid")

			local egg = closestEgg(root)

			-- skip eggs that failed too much
			if egg and pathFailures[egg.part] and pathFailures[egg.part] >= 5 then
				failedEggs[egg.part] = tick()
				egg = nil
			end

			if egg then
				if lastTargetEgg ~= egg then
					lastTargetEgg = egg
					Log("Going to "..egg.part.Name)
				elseif (root.Position - egg.part.Position).Magnitude < 8 then
					lastTargetEgg = nil -- stop log spam when already there
				end

				-- if already close, skip pathing and collect immediately
				if (root.Position - egg.part.Position).Magnitude < 8 then
					collectEgg(egg, root, humanoid)
					task.wait(0.2)
				else
					local success = walkTo(root, humanoid, egg.part.Position)

					if success then
						pathFailures[egg.part] = 0
						strategyMemory[egg.part] = 0

						if not collectEgg(egg, root, humanoid) then
							Log("Failed "..egg.part.Name,"error")
						end
					else
						pathFailures[egg.part] = (pathFailures[egg.part] or 0) + 1
						strategyMemory[egg.part] = (strategyMemory[egg.part] or 0) + 1

						if pathFailures[egg.part] >= 3 then
							local otherEgg = closestEgg(root)

							if otherEgg and otherEgg ~= egg then
								Log("Switching egg after 3 fails","warn")
								failedEggs[egg.part] = tick()
								retryState[egg.part] = (retryState[egg.part] or 0) + 1
							else
								retryState[egg.part] = (retryState[egg.part] or 0) + 1

								if retryState[egg.part] >= 2 then
									Log("Giving up on "..egg.part.Name,"error")
									failedEggs[egg.part] = math.huge
								else
									Log("Retrying same egg (no alternatives)","warn")
									pathFailures[egg.part] = 0
								end
							end
						end
					end
				end
			end
		end
		task.wait(0.3)
	end
end)
