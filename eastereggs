-- stats values
local totalEggs = 0
local totalCoins = 0

local function updateStats()
	local elapsed = tick() - startTime

	local eggsPerMin = 0
	local coinsPerHour = 0

	if elapsed > 0 then
		eggsPerMin = (totalEggs / elapsed) * 60
		coinsPerHour = (totalCoins / elapsed) * 3600
	end

	eggsLabel.Text = "Eggs: "..totalEggs.." ("..math.floor(eggsPerMin).."/m)"
	coinsLabel.Text = "Coins: "..totalCoins.." ("..math.floor(coinsPerHour).."/h)"
end

