local function isActuallyReachable(startPos, targetPos)
	local ray = workspace:Raycast(
		startPos,
		(targetPos - startPos),
		RaycastParams.new()
	)

	-- if nothing blocking → likely reachable by jump
	if not ray then
		return true
	end

	-- check if there's ground near target
	local down = workspace:Raycast(
		targetPos + Vector3.new(0,5,0),
		Vector3.new(0,-15,0)
	)

	return down ~= nil
end

local function findPlatformsAround(pos)
	local platforms = {}

	local region = Region3.new(
		pos - Vector3.new(20, 10, 20),
		pos + Vector3.new(20, 20, 20)
	)

	local parts = workspace:FindPartsInRegion3(region, nil, 100)

	for _, p in ipairs(parts) do
		if p:IsA("BasePart") and p.CanCollide then
			if p.Size.Y < 10 then -- avoid giant terrain
				table.insert(platforms, p.Position)
			end
		end
	end

	return platforms
end

local function getStrafePositions(rootPos, targetPos, attempt)
	local positions = {}

	local dir = (targetPos - rootPos).Unit
	local right = Vector3.new(-dir.Z, 0, dir.X) -- perpendicular
	local back = -dir

	-- pattern scaling
	local scale = 4 + (attempt * 2)

	if attempt == 1 then
		-- simple left/right
		table.insert(positions, rootPos + right * scale)
		table.insert(positions, rootPos - right * scale)

	elseif attempt == 2 then
		-- triangle movement
		table.insert(positions, rootPos + right * scale)
		table.insert(positions, rootPos + back * scale)
		table.insert(positions, rootPos - right * scale)

	elseif attempt == 3 then
		-- circle around target
		for i = 1, 6 do
			local angle = math.rad(i * 60)
			local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * scale
			table.insert(positions, targetPos + offset)
		end

	else
		-- chaos mode (last resort)
		for i = 1, 5 do
			table.insert(positions, rootPos + Vector3.new(
				math.random(-10,10),
				0,
				math.random(-10,10)
			))
		end
	end

	return positions
end

local function findJumpPoint(root, targetPos)
	local best = nil
	local bestScore = math.huge

	for i = 1, 25 do
		local offset = Vector3.new(
			math.random(-40,40),
			math.random(5,25), -- prefer higher spots
			math.random(-40,40)
		)

		local pos = root.Position + offset

		local ray = Ray.new(pos, Vector3.new(0,-50,0))
		local hit = workspace:FindPartOnRay(ray)

		if hit then
			local groundPos = hit.Position

			local distToTarget = (groundPos - targetPos).Magnitude

			-- prefer positions closer to target AND higher
			local score = distToTarget - (groundPos.Y * 0.5)

			if score < bestScore then
				bestScore = score
				best = groundPos
			end
		end
	end

	return best
end

local lastPathTime = 0

local function tryParkour(root, humanoid, dest)
	local platforms = findPlatformsAround(root.Position)

	table.sort(platforms, function(a, b)
		return (a - dest).Magnitude < (b - dest).Magnitude
	end)

	for i = 1, math.min(5, #platforms) do
		local pos = platforms[i]

		Log("Trying platform jump","info")

		humanoid:MoveTo(pos)
		humanoid.Jump = true

		task.wait(0.4)

		if (root.Position - pos).Magnitude < 5 then
			return true
		end
	end

	return false
end

local function longJump(root, target)
	local dir = (target - root.Position)
	local flatDir = Vector3.new(dir.X, 0, dir.Z).Unit

	root.Velocity = Vector3.new(
		flatDir.X * 70,
		75,
		flatDir.Z * 70
	)

	task.wait(0.4)
end

