--// PATH
--// =========================

local pathFolder = Instance.new("Folder", workspace)

local currentPathParts = {}

local function drawPath(points)
	-- clear old
	for _, p in pairs(currentPathParts) do
		if p then p:Destroy() end
	end
	currentPathParts = {}

	for i, wp in ipairs(points) do
		local p = Instance.new("Part")
		p.Size = Vector3.new(0.6,0.6,0.6)
		p.Position = wp.Position + Vector3.new(0,0.2,0)
		p.Anchored = true
		p.CanCollide = false
		p.Material = Enum.Material.Neon
		p.Color = Color3.fromRGB(170,0,255)
		p.Parent = pathFolder

		currentPathParts[i] = p
	end

	return currentPathParts
end

local lastPathTime = 0

local function walkTo(root, humanoid, dest)
	local lastPos = root.Position
	local stuckTime = 0

	while RUNNING do
		-- avoid known bad spots
		if isBadPosition(dest) then
			Log("Skipping bad location","warn")
			return false
		end

		local path = PathfindingService:CreatePath({
			AgentCanJump = true,
			AgentJumpHeight = 8,
			AgentRadius = 2,
			AgentMaxSlope = 45
		})

		path:ComputeAsync(root.Position, dest)

		if path.Status ~= Enum.PathStatus.Success then
			Log("Path failed → marking bad","warn")
			table.insert(badPositions, dest)
			return false
		end

		local waypoints = path:GetWaypoints()

		-- ✅ RESTORE PATH VISUALS
		local visuals = drawPath(waypoints)

		for i, wp in ipairs(waypoints) do
			-- ✅ JUMP FIX
			if wp.Action == Enum.PathWaypointAction.Jump then
				humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			end

			humanoid:MoveTo(wp.Position)

			local reached = humanoid.MoveToFinished:Wait()

			-- remove path dot
			if visuals and visuals[i] then
				visuals[i]:Destroy()
			end

			-- STUCK DETECTION
			if (root.Position - lastPos).Magnitude < 1 then
				stuckTime = stuckTime + 1
			else
				stuckTime = 0
			end

			lastPos = root.Position

			if stuckTime >= 3 then
				Log("Stuck → strafing + marking bad","warn")

				-- 🧠 remember bad location
				table.insert(badPositions, root.Position)

				-- 🧠 better unstuck (circle strafe)
				for i = 1,3 do
					local offset = Vector3.new(
						math.random(-6,6),
						0,
						math.random(-6,6)
					)
					humanoid:MoveTo(root.Position + offset)
					task.wait(0.4)
				end

				return false
			end

			if not reached then
				break
			end
		end

		if (root.Position - dest).Magnitude < 6 then
			return true
		end

		task.wait(0.2)
	end

	return false
end

